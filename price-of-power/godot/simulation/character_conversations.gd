@export var discussed: Dictionary = {}
@export var last_topics: Dictionary = {}
@export var decisions: Dictionary = {}
@export var last_decision_cases: Dictionary = {}

func last_response(person_id: String) -> String:
	var option_id := str(last_topics.get(person_id, ""))
	var receipt := latest_decision(person_id)
	if receipt.get("option_id") == option_id:
		return str(receipt["response"])
	return str(option(person_id, option_id).get("response", ""))

func people_at(location_id: String, state: WorldState) -> Array[String]:
	var result: Array[String] = []
	var cast: Array = LOCATION_CAST.get(location_id, []) + LOCATION_PEOPLE.LOCATION_CAST.get(location_id, [])
	for person_id: String in cast:
		if _person_available(person_id, state):
			result.append(person_id)
	return result

func _person_available(person_id: String, state: WorldState) -> bool:
	if not state.characters.has(person_id) or not COURT_AUTHORITY.is_present(state, person_id):
		return false
	if person_id == "spouse":
		return str(state.facts.get("family_security", "")) not in ["country_cloister", "breached"]
	if person_id == "savva":
		var fate := str(state.facts.get("savva_fate", ""))
		if fate == "protected_witness":
			var meeting: Dictionary = state.story_timeline.resolved.get("savva_at_chapel", {})
			return meeting.is_empty() or state.calendar.cycle > int(meeting.get("cycle", 0))
		return fate == "voluntary_witness"
	if person_id == "vardan":
		return str(state.facts.get("vardan_stance", "")) == "inside_council"
	return true

func profile(person_id: String, state: WorldState = null) -> Dictionary:
	var result: Dictionary = PROFILES.get(person_id, LOCATION_PEOPLE.PROFILES.get(person_id, {})).duplicate()
	if state == null:
		return result
	var request: Dictionary = REQUESTS.get(person_id, {})
	if not request.is_empty() and (not _meets_story_conditions(request, state) or decisions.has(_key(person_id, str(request["id"])))):
		result["prompt"] = SETTLED_TOPICS.get(person_id, "")
		result["opening"] = ""
	var supplemental: Dictionary = LOCATION_PEOPLE.SETTLED_TOPICS.get(person_id, {})
	if not supplemental.is_empty() and (state.facts.has(str(supplemental["fact"])) or not _meets_story_conditions(supplemental, state)):
		result["prompt"] = supplemental["prompt"]
		result["opening"] = ""
	if person_id == "savva":
		var setting := _savva_visit_setting(state)
		if not setting.is_empty():
			result["prompt"] = setting
	return result

func _savva_visit_setting(state: WorldState) -> String:
	match str(state.facts.get("savva_fate", "")):
		"protected_witness":
			return "Люди Радомира привели раненого Савву в закрытую келью приходского храма. Он уже может говорить, но попросил не пускать городскую стражу."
		"voluntary_witness":
			return "Марек проводил Савву в келью приходского храма: здесь писец согласился говорить на условиях безопасного допроса."
	return ""

func location_ids() -> Array:
	return LOCATION_CAST.merged(LOCATION_PEOPLE.LOCATION_CAST).keys()

func pending_story_topics(state: WorldState) -> Array[Dictionary]:
	var leads: Array[Dictionary] = []
	for location_id: String in location_ids():
		for person_id: String in people_at(location_id, state):
			var city_case := _active_city_case(person_id, state)
			if not city_case.is_empty():
				leads.append({
					"location_id": location_id, "person_id": person_id, "option_id": "",
					"label": city_case["lead"], "city_case": city_case["fact"], "case_id": city_case["fact"], "setup": city_case["setup"]
				})
			for option_id: String in available_options(person_id, state):
				var label := str(option(person_id, option_id).get("lead", ""))
				if not label.is_empty() and not bool(discussed.get(_key(person_id, option_id), false)):
					var case := _decision_case(person_id, option_id)
					leads.append({"location_id": location_id, "person_id": person_id, "option_id": option_id, "label": label, "case_id": case.get("id", "")})
	return leads

func city_case_brief(person_id: String, state: WorldState) -> String:
	return str(_active_city_case(person_id, state).get("setup", ""))

func _active_city_case(person_id: String, state: WorldState) -> Dictionary:
	var city_case: Dictionary = CITY_CASES.get(person_id, {})
	if city_case.is_empty() or state == null or state.calendar.is_demo_complete():
		return {}
	if state.calendar.cycle < int(city_case["start_cycle"]) or state.calendar.cycle > int(city_case["end_cycle"]):
		return {}
	if state.facts.has(str(city_case["fact"])) or not _meets_story_conditions(city_case, state):
		return {}
	return city_case

func available_options(person_id: String, state: WorldState = null) -> Array[String]:
	var result: Array[String] = []
	if state != null and not _person_available(person_id, state):
		return result
	var city_options: Dictionary = _active_city_case(person_id, state).get("options", {})
	for option_id: String in city_options:
		if _decision_is_open(person_id, option_id):
			result.append(option_id)
	var city_case: Dictionary = CITY_CASES.get(person_id, {})
	if not city_options.is_empty() or (state != null and state.facts.has(str(city_case.get("fact", "")))):
		for question_id: String in city_case.get("questions", {}):
			result.append(question_id)
	var ordinary := _main_options(person_id)
	var request: Dictionary = REQUESTS.get(person_id, {})
	for option_id: String in ordinary:
		if not _meets_story_conditions(ordinary[option_id], state):
			continue
		if state != null and option_id in request.get("options", []) and not _meets_story_conditions(request, state):
			continue
		if state != null and state.calendar.is_demo_complete() and option_kind(person_id, option_id) == "decision":
			continue
		if _decision_is_open(person_id, option_id):
			result.append(option_id)
	return result

func question_options(person_id: String, state: WorldState) -> Dictionary:
	var questions: Dictionary = {}
	for option_id: String in available_options(person_id, state):
		if option_kind(person_id, option_id) == "question":
			var data := option(person_id, option_id).duplicate()
			data["asked"] = bool(discussed.get(_key(person_id, option_id), false))
			questions[option_id] = data
	return questions

func decision_cases(person_id: String, state: WorldState) -> Array[Dictionary]:
	if state != null and state.calendar.is_demo_complete():
		return []
	var by_id: Dictionary = {}
	for option_id: String in available_options(person_id, state):
		var case := _decision_case(person_id, option_id)
		if case.is_empty():
			continue
		var id := str(case["id"])
		if not by_id.has(id):
			if id == "witness_hearing":
				var setting := _savva_visit_setting(state)
				if not setting.is_empty():
					case["brief"] = "%s %s" % [setting, case["brief"]]
			if state != null:
				var callback := _late_case_callback(id, state)
				if not callback.is_empty():
					case["brief"] = "%s %s" % [callback, case["brief"]]
				if id == "miron_grain_oversight" and state.facts.get("rural_repair") == "winter_credit":
					case["brief"] += " Мирон видел грамоту Гаврилы. Он предлагает применять тот же порядок проверки, когда осенью в очередь первыми встанут дворы из его списка."
			case["options"] = {}
			by_id[id] = case
		by_id[id]["options"][option_id] = option(person_id, option_id)
	var result: Array[Dictionary] = []
	for case: Dictionary in by_id.values():
		result.append(case)
	return result

func _late_case_callback(case_id: String, state: WorldState) -> String:
	match case_id:
		"miron_grain_oversight":
			var speech: Dictionary = state.story_timeline.resolved.get("market_speech", {})
			if state.facts.get("miron_public_witnesses", false):
				return "Двое старшин, с которыми Мирон договаривался о проверке ночных грамот, согласны прийти и к весам."
			if speech.get("choice") == "disperse":
				if state.facts.get("miron_hearing_promised", false):
					return "«В прошлый раз вы обещали выслушать троих, а я привёл их к строю стражи», — говорит Мирон. Сегодня он пришёл сам. Просителей пока не позвал."
				return "После разгона Мирон не зовёт просителей на площадь, пока не услышит ваш ответ."
			if speech.get("choice") == "answer":
				return "«На площади вы показали, как считали прошлую выдачу, — говорит Мирон. — Теперь пусть люди сами увидят, сколько насыпали в новый мешок»."
		"daren_watch_repair":
			match state.facts.get("command_structure"):
				"military": return "«Приказ Радомира я исполнил, — говорит Дарен. — А книгу смен всё равно принесли мне. У него казармы, у меня люди у этих ворот»."
				"joint": return "Дарен кладёт рядом две подписи с ночного приказа. Одна и та же смена по книгам в это время стояла на разных постах."
				"split": return "«У стены мы поделили людей, а у ворот не поделили ключи, — говорит Дарен. — Внутри мой пост, снаружи пост Радомира. Запор один»."
		"north_gate_shift":
			if state.facts.get("north_gate_relief") == "families":
				return "Семьи уже у Лады. У ворот ещё стоят телеги с мукой. Дарен принёс накладные и просит людей для осмотра груза."
			return "Муку уже приняли. Под навесом ждут семьи без пропусков. Дарен принёс список старост, которые могут подтвердить, из каких деревень люди пришли."
		"vardan_quay_terms":
			if state.facts.get("vardan_river_manifest") == "listed":
				return "Вардан принёс уже записанные имена хозяев лодок. Просит сверить их сейчас, пока люди ждут на воде."
			if state.facts.get("vardan_river_manifest") == "refused":
				return "«Без вашего слова мои лодки на казённый причал не пошли», — говорит Вардан. «Теперь у вас там очередь до поворота. Хотите обсудить разгрузку ещё раз?»"
	return ""

func latest_decision(person_id: String) -> Dictionary:
	var id := str(last_decision_cases.get(person_id, ""))
	return (decisions.get(_key(person_id, id), {}) as Dictionary).duplicate()

func decision_history() -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	for decision: Dictionary in decisions.values():
		result.append({
			"cycle": int(decision.get("cycle", 1)), "title": str(decision["case_title"]),
			"choice": str(decision["title"]), "outcome": str(decision["response"])
		})
	return result

func option_kind(person_id: String, option_id: String) -> String:
	return "question" if _decision_case(person_id, option_id).is_empty() else "decision"

func _key(person_id: String, topic_id: String) -> String:
	return "%s:%s" % [person_id, topic_id]

func _decision_is_open(person_id: String, option_id: String) -> bool:
	var case := _decision_case(person_id, option_id)
	return case.is_empty() or not decisions.has(_key(person_id, str(case["id"])))

func _decision_case(person_id: String, option_id: String) -> Dictionary:
	var city_case: Dictionary = CITY_CASES.get(person_id, {})
	if (city_case.get("options", {}) as Dictionary).has(option_id):
		return {"id": city_case["fact"], "title": city_case["lead"], "brief": city_case["setup"]}
	var request: Dictionary = REQUESTS.get(person_id, {})
	if option_id in request.get("options", []):
		return {"id": request["id"], "title": request["title"], "brief": request["brief"]}
	var data := option(person_id, option_id)
	var story_id := str(data.get("story_case", option_id))
	if STORY_REQUESTS.has(story_id) and _main_options(person_id).has(option_id):
		var story_request: Dictionary = STORY_REQUESTS[story_id]
		return {"id": story_id, "title": story_request["title"], "brief": story_request["brief"]}
	if data.get("kind") == "decision":
		return {"id": data["case_id"], "title": data["case_title"], "brief": data["brief"]}
	return {}

func _meets_story_conditions(data: Dictionary, state: WorldState) -> bool:
	var required_facts: Dictionary = data.get("requires_facts", {})
	var closing_facts: Array = data.get("closes_on_facts", [])
	var required_event := str(data.get("requires_event", ""))
	var closing_event := str(data.get("closes_after", ""))
	var expires_after := int(data.get("expires_after_cycle", -1))
	if state == null:
		return required_facts.is_empty() and required_event.is_empty() and closing_event.is_empty() and closing_facts.is_empty() and expires_after < 0
	if expires_after >= 0 and state.calendar.cycle > expires_after:
		return false
	for key: String in closing_facts:
		if state.facts.has(key):
			return false
	for key: String in required_facts:
		if state.facts.get(key) != required_facts[key]:
			return false
	var resolved := state.story_timeline.resolved
	if not required_event.is_empty():
		var record: Dictionary = resolved.get(required_event, {})
		if record.get("choice") not in data["requires_choices"]:
			return false
	return closing_event.is_empty() or not resolved.has(closing_event)

func option(person_id: String, option_id: String) -> Dictionary:
	var main_options := _main_options(person_id)
	if main_options.has(option_id):
		return main_options[option_id]
	var city_case: Dictionary = CITY_CASES.get(person_id, {})
	var city_options: Dictionary = city_case.get("options", {})
	return city_options.get(option_id, (city_case.get("questions", {}) as Dictionary).get(option_id, {}))

func _main_options(person_id: String) -> Dictionary:
	return OPTIONS.get(person_id, LOCATION_PEOPLE.OPTIONS.get(person_id, {}))

func choose(state: WorldState, person_id: String, option_id: String) -> String:
	if option_id not in available_options(person_id, state):
		return ""
	var data := option(person_id, option_id)
	var case := _decision_case(person_id, option_id)
	if data.is_empty() or (not case.is_empty() and (state.calendar.is_demo_complete() or not state.can_govern())):
		return ""
	discussed[_key(person_id, option_id)] = true
	last_topics[person_id] = option_id
	if case.is_empty():
		return str(data["response"])
	_record_decision(person_id, option_id, case, data, state.calendar.cycle)
	var person: CharacterState = state.characters[person_id]
	person.remember(state.calendar.cycle, "conversation_%s" % option_id, "Решение: %s" % str(data["title"]), data.get("changes", {}))
	var new_facts: Dictionary = data.get("sets_facts", {})
	state.facts.merge(new_facts, true)
	if data.has("outcome"):
		_apply_city_case_choice(state, person_id, data)
	if data.has("order_change") or data.has("gold_change") or data.has("faction_changes"):
		_apply_public_reaction(state, data)
	state.add_fatigue(1)
	state.consequence_log.append({"cycle": state.calendar.cycle, "kind": "character_conversation", "person": person_id, "option": option_id})
	return str(data["response"])

func _record_decision(person_id: String, option_id: String, case: Dictionary, option_data: Dictionary, cycle: int = 1) -> void:
	var id := str(case["id"])
	decisions[_key(person_id, id)] = {
		"case_id": id, "case_title": case["title"], "option_id": option_id, "cycle": cycle,
		"title": option_data["title"], "response": option_data["response"]
	}
	last_decision_cases[person_id] = id

func _apply_city_case_choice(state: WorldState, person_id: String, data: Dictionary) -> void:
	var city_case: Dictionary = CITY_CASES[person_id]
	state.facts[str(city_case["fact"])] = data["outcome"]

func _apply_public_reaction(state: WorldState, data: Dictionary) -> void:
	state.public_order = clampi(state.public_order + int(data.get("order_change", 0)), 0, 100)
	state.state_treasury += int(data.get("gold_change", 0))
	var faction_changes: Dictionary = data.get("faction_changes", {})
	for faction_id: String in faction_changes:
		var faction := state.factions[faction_id] as FactionState
		faction.react(state.calendar.cycle, int(faction_changes[faction_id]), str(data["reaction"]))

func to_data() -> Dictionary:
	return {
		"discussed": discussed.duplicate(true), "last_topics": last_topics.duplicate(true),
		"decisions": decisions.duplicate(true), "last_decision_cases": last_decision_cases.duplicate(true)
	}

func load_data(data: Dictionary) -> void:
	discussed = (data.get("discussed", {}) as Dictionary).duplicate(true)
	last_topics = (data.get("last_topics", {}) as Dictionary).duplicate(true)
	decisions = (data.get("decisions", {}) as Dictionary).duplicate(true)
	last_decision_cases = (data.get("last_decision_cases", {}) as Dictionary).duplicate(true)
	if not data.has("decisions"):
		_restore_old_decisions()

func _restore_old_decisions() -> void:
	# Older saves have a set of played replies and a single remembered reply.
	# Preserve their effects and lock those cases without applying anything again.
	for key: String in discussed:
		var parts := key.split(":", false, 1)
		if parts.size() != 2 or not discussed[key]:
			continue
		var case := _decision_case(parts[0], parts[1])
		if not case.is_empty():
			_record_decision(parts[0], parts[1], case, option(parts[0], parts[1]))
	for person_id: String in last_topics:
		var option_id := str(last_topics[person_id])
		var last_case := _decision_case(person_id, option_id)
		if not last_case.is_empty():
			_record_decision(person_id, option_id, last_case, option(person_id, option_id))
